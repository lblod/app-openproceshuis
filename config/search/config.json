{
    "automatic_index_updates": true,
    "persist_indexes": true,
    "number_of_threads": 8,
    "ignored_allowed_groups": [
        {
            "name": "clean",
            "variables": []
        }
    ],
    "eager_indexing_groups": [
        [
            {
                "name": "shared-processes-reader",
                "variables": []
            },
            {
                "name": "authenticated",
                "variables": []
            }
        ],
        [
            {
                "name": "public",
                "variables": []
            }
        ]
    ],
    "default_settings": {
        "analysis": {
            "normalizer": {
                "lowercase_normalizer": {
                    "type": "custom",
                    "char_filter": [],
                    "filter": [
                        "lowercase",
                        "trim",
                        "asciifolding"
                    ]
                }
            }
        }
    },
    "prefixes": {
        "dpv": "https://w3id.org/dpv#",
        "dcterms": "http://purl.org/dc/terms/",
        "oph": "http://lblod.data.gift/vocabularies/openproceshuis/",
        "icr": "http://lblod.data.gift/vocabularies/informationclassification/",
        "adms": "http://www.w3.org/ns/adms#",
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "besluit": "http://data.vlaanderen.be/ns/besluit#",
        "mu": "http://mu.semte.ch/vocabularies/core/",
        "organisatie": "http://lblod.data.gift/vocabularies/organisatie/"
    },
    "types": [
        {
            "type": "process",
            "on_path": "processes",
            "rdf_type": "dpv:Process",
            "properties": {
                "created": "dcterms:created",
                "modified": "dcterms:modified",
                "status": "adms:status",
                "title": "dcterms:title",
                "description": "dcterms:description",
                "isVersionedResource": "oph:isVersionedResource",
                "isBlueprint": "icr:isBlueprint",
                "publisher": {
                    "via": "dcterms:publisher",
                    "rdf_type": "besluit:Bestuurseenheid",
                    "properties": {
                        "name": "skos:prefLabel"
                    }
                },
                "creator": {
                    "via": "dcterms:creator",
                    "rdf_type": "besluit:Bestuurseenheid",
                    "properties": {
                        "name": "skos:prefLabel"
                    }
                },
                "relevantAdministrativeUnits": {
                    "via": "icr:isRelevantForAdministrativeUnit",
                    "rdf_type": "organisatie:BestuurseenheidClassificatieCode",
                    "properties": {
                        "id": "mu:uuid",
                        "name": "skos:prefLabel"
                    }
                },
                "ipdcProductIds": [
                    "^http://purl.org/vocab/cpsv#follows",
                    "mu:uuid"
                ]
            },
            "mappings": {
                "properties": {
                    "title": {
                        "type": "text",
                        "fields": {
                            "keyword": {
                                "type": "keyword",
                                "normalizer": "lowercase_normalizer"
                            }
                        }
                    },
                    "description": {
                        "type": "text",
                        "fields": {
                            "keyword": {
                                "type": "keyword",
                                "normalizer": "lowercase_normalizer"
                            }
                        }
                    },
                    "modified": {
                        "type": "date"
                    },
                    "publisher.name": {
                        "type": "text",
                        "fields": {
                            "keyword": {
                                "type": "keyword",
                                "normalizer": "lowercase_normalizer"
                            }
                        }
                    },
                    "creator.name": {
                        "type": "text",
                        "fields": {
                            "keyword": {
                                "type": "keyword",
                                "normalizer": "lowercase_normalizer"
                            }
                        }
                    },
                    "relevantAdministrativeUnits.name": {
                        "type": "text",
                        "fields": {
                            "keyword": {
                                "type": "keyword",
                                "normalizer": "lowercase_normalizer"
                            }
                        }
                    }
                }
            }
        }
    ]
}