DELETE {
  GRAPH ?g { ?s ?pHttps ?o }
}
INSERT {
  GRAPH ?g { ?s ?pHttp ?o }
}
WHERE {
  VALUES (?pHttps ?pHttp) {
    (<https://schema.org/associatedMedia> <http://schema.org/associatedMedia>)
    (<https://schema.org/email>           <http://schema.org/email>)
    (<https://schema.org/endDate>         <http://schema.org/endDate>)
    (<https://schema.org/productID>       <http://schema.org/productID>)
    (<https://schema.org/publisher>       <http://schema.org/publisher>)
    (<https://schema.org/startDate>       <http://schema.org/startDate>)
  }
  GRAPH ?g { ?s ?pHttps ?o }
}